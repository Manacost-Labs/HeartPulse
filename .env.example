# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Transactional and newsletter mail sent through the local sendmail-compatible MTA.
AUTH_FROM="noreply@hs-manacost.ru"
NEWSLETTER_FROM="noreply@hs-manacost.ru"
NEWSLETTER_FROM_NAME="Manacost"
NEWSLETTER_UNSUBSCRIBE_SECRET="replace-with-a-long-random-secret"
SENDMAIL_PATH="/usr/sbin/sendmail"

# Redis cache for heavy public datasets. Set REDIS_ENABLED=0 to fall back to in-process memory only.
REDIS_ENABLED=1
REDIS_URL="redis://127.0.0.1:6379"
REDIS_CACHE_PREFIX="hs-arena:v2"
REDIS_DATASET_TTL_SECONDS=21600
REDIS_HOME_SUMMARY_TTL_SECONDS=300
DATASET_MEMORY_CACHE_MS=300000
# Raw Standard/Wild card catalogs remain usable for at most this many hours
# after the last complete validation. The server bounds the value to 1–168.
CONSTRUCTED_CARD_CATALOG_MAX_STALE_HOURS=48

# Admin-only Standard Meta beta: the key is used exclusively by the server to
# request deck renders and must never be exposed through VITE_* variables.
KOLODAHS_RENDER_API_BASE_URL="https://api.kolodahs.ru"
KOLODAHS_API_KEY="replace-with-a-kolodahs-server-key"

# Admin parser control BFF. The API key is server-only and must never use a VITE_* name.
HS_DATA_API_BASE_URL="https://api.hs-manacost.ru"
HS_DATA_API_ADMIN_KEY="replace-with-the-hs-data-api-server-key"
HS_DATA_API_ADMIN_TIMEOUT_MS=15000

# Optional Sentry error monitoring. The SDK stays completely disabled when the
# DSN is absent. Tracing is opt-in (0 by default); PII sending remains disabled.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE=""
SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="production"
VITE_SENTRY_RELEASE=""
VITE_SENTRY_TRACES_SAMPLE_RATE=0
# Browser RUM posts a bounded, credential-free batch to the same-origin server,
# which forwards metrics only when the server-only SENTRY_DSN is configured.
# Lower this bounded 0..1 sample only if Sentry volume requires it.
VITE_SENTRY_WEB_VITALS_SAMPLE_RATE=1
