{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "allowJs": false,
    "declaration": false,
    "isolatedModules": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "build",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "server/index.ts",
    "server/sentry.ts",
    "server/scraper.ts",
    "server/blizzardCards.ts",
    "server/cardImageCache.ts",
    "server/constructedCardImagePrewarmer.ts",
    "server/hsreplayArenasmith.ts",
    "server/health.ts",
    "server/healthRoutes.ts",
    "server/jsonBody.ts",
    "server/metrics.ts",
    "server/networkBoundary.ts",
    "server/observability.ts",
    "server/viciousGoldBuilds.ts",
    "server/referralRoutes.ts",
    "server/referrals.ts",
    "server/scrapeQueue.ts",
    "server/snapshots.ts",
    "server/guides/**/*.ts",
    "src/telemetry/sentryPrivacy.ts"
  ]
}
