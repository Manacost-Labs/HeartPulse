[Unit]
Description=HS-Arena isolated validated scraper
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/www/koloda/data/www/hs-arena.ru/current/build/server/scraper.js

[Service]
Type=oneshot
User=koloda
Group=koloda
WorkingDirectory=/var/www/koloda/data/www/hs-arena.ru/current
EnvironmentFile=/etc/hs-arena/hs-arena.env
EnvironmentFile=-/etc/db-kolodahs-card-scan.env
EnvironmentFile=-/etc/hs-arena/browser-runtime.env
Environment=APP_ROOT_DIR=/var/www/koloda/data/www/hs-arena.ru/current
Environment=SERVER_DATA_DIR=/var/www/koloda/data/www/hs-arena.ru/shared/server-data
ExecStartPre=-/usr/bin/rm -f /var/www/koloda/data/www/hs-arena.ru/shared/server-data/.scrape-request
ExecStart=/usr/bin/node build/server/scraper.js
TimeoutStartSec=45m
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
