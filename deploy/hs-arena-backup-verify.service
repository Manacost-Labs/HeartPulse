[Unit]
Description=Verify latest encrypted HS-Arena backup restore

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/hs-arena/backup.env
ExecStart=/var/www/koloda/data/www/hs-arena.ru/current/scripts/verify-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
