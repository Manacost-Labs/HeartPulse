HEARTHPULSE_BACKUP_REMOTE_HOST=backup.example.net
HEARTHPULSE_BACKUP_REMOTE_USER=arena_backup
HEARTHPULSE_BACKUP_REMOTE_DIR=/srv/backups/hearthpulse
HEARTHPULSE_BACKUP_REMOTE_PORT=22
HEARTHPULSE_BACKUP_SSH_KEY=/etc/hearthpulse/backup-replication-key
HEARTHPULSE_BACKUP_KNOWN_HOSTS=/etc/hearthpulse/backup-known-hosts
