[Unit]
Description=Replicate latest encrypted HearthPulse backup off site
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/hearthpulse/backup.env
EnvironmentFile=/etc/hearthpulse/backup-remote.env
ExecStart=/bin/bash /var/www/koloda/data/www/hs-arena.ru/current/scripts/replicate-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
NoNewPrivileges=true
