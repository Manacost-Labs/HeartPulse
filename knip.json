{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.{js,mjs}",
    ".storybook/**/*.{ts,tsx}",
    "src/**/*.stories.{ts,tsx}",
    "apps/public-web/app/**/*.{ts,tsx}",
    "apps/public-web/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx,css,mdx}",
    ".storybook/**/*.{ts,tsx,css}",
    "server/**/*.ts",
    "scripts/*.{js,mjs}",
    "apps/public-web/{app,lib,ui}/**/*.{ts,tsx}",
    "apps/public-web/*.mjs"
  ],
  "ignore": [
    "public/**",
    "database/**",
    "asset-archive/**"
  ],
  "ignoreDependencies": [
    "chrome-devtools-mcp",
    "react-doctor"
  ],
  "ignoreBinaries": [
    "codex",
    "context-economy",
    "openssl"
  ],
  "postcss": {
    "config": [
      "apps/public-web/postcss.config.mjs"
    ]
  }
}
