{
  "name": "manacost-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --port=3000 --host=0.0.0.0\" \"tsx --watch server/index.ts\"",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx --watch server/index.ts",
    "build": "vite build && npm run build:server && node scripts/prerender.js",
    "build:server": "rm -rf build && tsc -p tsconfig.server.json && chmod -R a+rX build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "lint:docs": "markdownlint-cli2 STABILIZATION.md DEPLOYMENT.md assets.md && design.md lint design.md",
    "lint:architecture": "node scripts/check-component-duplicates.mjs && node scripts/check-css-architecture.mjs && node scripts/check-entry-dead-code.mjs",
    "budget": "node scripts/check-budgets.js",
    "optimize:ui-assets": "node scripts/optimize-ui-assets.mjs",
    "test:tierlist": "tsx tests/hsreplay-tierlist.test.ts",
    "test:blizzard": "tsx tests/blizzard-card-images.test.ts",
    "test:guides": "tsx tests/guides-sanitize.test.ts",
    "test:health": "tsx tests/health.test.ts",
    "test:observability": "tsx tests/observability.test.ts",
    "test:auth-security": "tsx tests/auth-security.test.ts",
    "test:csrf": "tsx tests/csrf.test.ts",
    "test:metrics": "tsx tests/metrics.test.ts",
    "test:network-boundary": "tsx tests/network-boundary.test.ts",
    "test:json-body": "tsx tests/json-body.test.ts",
    "test:production-monitor": "node tests/production-monitor.test.mjs",
    "test:qa-contract": "node tests/qa-command-contract.test.mjs",
    "test:referrals": "tsx tests/referrals.test.ts",
    "test:referral-routes": "tsx tests/referral-routes.test.ts",
    "test:gallery-routes": "tsx tests/gallery-routes.test.ts",
    "test:contest-selection": "tsx tests/contest-selection.test.ts",
    "test:admin-workspace-state": "tsx tests/admin-workspace-state.test.ts",
    "test:backup": "bash tests/backup-restore.test.sh && bash tests/backup-replication.test.sh",
    "test:release": "node tests/create-release.test.mjs",
    "test:snapshots": "tsx tests/snapshots.test.ts",
    "test:scrape-queue": "tsx tests/scrape-queue.test.ts",
    "test:deployment": "node tests/deploy-release.test.mjs",
    "test:routes": "tsx tests/routes.test.ts",
    "test:server-build": "node scripts/server-build-smoke.mjs",
    "test:recovery-runtime": "node scripts/recovery-runtime-smoke.mjs",
    "test": "TIERLIST_TEST_SKIP_HANDLER=1 npm run test:tierlist && npm run test:blizzard && npm run test:guides && npm run test:health && npm run test:observability && npm run test:auth-security && npm run test:csrf && npm run test:metrics && npm run test:network-boundary && npm run test:json-body && npm run test:production-monitor && npm run test:qa-contract && npm run test:referrals && npm run test:referral-routes && npm run test:gallery-routes && npm run test:contest-selection && npm run test:admin-workspace-state && npm run test:backup && npm run test:release && npm run test:snapshots && npm run test:scrape-queue && npm run test:deployment && npm run test:routes",
    "verify:ci": "npm run lint && npm run lint:architecture && npm test && npm run build && npm run test:server-build && npm run test:recovery-runtime && npm run budget && node scripts/browser-qa-ci.mjs && npm run lint:docs",
    "scrape": "tsx server/scraper.ts",
    "qa:screens": "node scripts/screenshot-qa.mjs",
    "qa:e2e": "node scripts/e2e-qa.mjs",
    "qa:ci": "npm run build && node scripts/browser-qa-ci.mjs",
    "release:create": "node scripts/create-release.mjs",
    "changelog:post": "node scripts/post-arena-changelog.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.1",
    "concurrently": "^9.2.3",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "lucide-react": "^0.546.0",
    "node-cron": "^4.5.0",
    "puppeteer": "^22.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^4.7.1",
    "sanitize-html": "2.17.5",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@google/design.md": "0.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/sanitize-html": "2.16.1",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.12.1",
    "markdownlint-cli2": "0.23.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "description": "Hearthstone Arena statistics — tier list, class winrates, legendary groups"
}
