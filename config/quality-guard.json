{
  "version": 1,
  "stack": "nextjs",
  "project": "HearthPulse",
  "design": {
    "tokens": {
      "from_css": [
        "src/styles/tokens.css"
      ]
    },
    "token_sources": [
      "src/styles/tokens.css"
    ],
    "registry": [
      {
        "name": "HeaderProfileButton",
        "source": "src/app/shell/HeaderProfileButton.tsx",
        "stories": [
          "src/app/shell/HeaderProfileButton.stories.tsx"
        ],
        "tokens": [
          "--arena-gold",
          "--arena-ink"
        ],
        "states": [
          "signed-out",
          "signed-in",
          "focus"
        ],
        "keywords": [
          "профиль",
          "аккаунт",
          "вход",
          "личный кабинет",
          "авторизация"
        ],
        "screenshots": [
          "scripts/quality/references/profile-desktop.png"
        ],
        "screenshot_sources": {
          "src/app/shell/HeaderProfileButton.tsx": "6499b742425c6fc2337f8f14b5781f2b95f3e075bed3c7a394f78184352626b5",
          "src/styles/tokens.css": "fa20c3d18cb98aa57c29561b3c2e030b132c3dc104e1abaae09ed8676b98b7e6"
        },
        "screenshot_scope": "Authenticated desktop page reference, generated by the native fixture browser suite at 7656c82."
      },
      {
        "name": "SubscriptionPurchaseButtons",
        "source": "src/components/SubscriptionPurchaseButtons.tsx",
        "tokens": [
          "--arena-gold"
        ],
        "states": [
          "available",
          "pending"
        ],
        "keywords": [
          "подписка",
          "оплата",
          "покупка",
          "тариф",
          "billing"
        ]
      },
      {
        "name": "ConstructedCardDownloadButton",
        "source": "src/features/ConstructedCardDownloadButton.tsx",
        "tokens": [
          "--arena-ink"
        ],
        "states": [
          "ready",
          "loading"
        ],
        "keywords": [
          "карта",
          "скачать",
          "загрузка",
          "изображение"
        ]
      }
    ]
  },
  "checks": [
    {
      "id": "types",
      "argv": [
        "npm",
        "run",
        "lint"
      ],
      "tier": "fast",
      "paths": []
    },
    {
      "id": "next-types",
      "argv": [
        "npm",
        "run",
        "lint:next"
      ],
      "tier": "fast",
      "paths": [
        "apps/public-web/**"
      ]
    },
    {
      "id": "test-registry",
      "argv": [
        "npm",
        "run",
        "test:registry"
      ],
      "tier": "fast",
      "paths": []
    },
    {
      "id": "architecture",
      "argv": [
        "npm",
        "run",
        "lint:architecture"
      ],
      "tier": "medium",
      "paths": []
    },
    {
      "id": "security",
      "argv": [
        "npm",
        "run",
        "security:semgrep:strict"
      ],
      "tier": "medium",
      "paths": [],
      "network": true
    },
    {
      "id": "unused-dependencies",
      "argv": [
        "npm",
        "run",
        "quality:knip"
      ],
      "tier": "medium",
      "paths": []
    },
    {
      "id": "storybook",
      "argv": [
        "npm",
        "run",
        "test:storybook"
      ],
      "tier": "medium",
      "paths": [],
      "family": "design"
    },
    {
      "id": "storybook-build",
      "argv": [
        "npm",
        "run",
        "build-storybook"
      ],
      "tier": "heavy",
      "paths": [],
      "family": "design",
      "timeout": 600
    },
    {
      "id": "design-tokens",
      "argv": [
        "{python}",
        "{quality_root}/design_guard.py",
        "--config",
        "config/quality-guard.json",
        "tokens"
      ],
      "tier": "fast",
      "paths": [],
      "family": "design"
    },
    {
      "id": "design-components",
      "argv": [
        "{python}",
        "{quality_root}/design_guard.py",
        "--config",
        "config/quality-guard.json",
        "components"
      ],
      "tier": "fast",
      "paths": [],
      "family": "design"
    },
    {
      "id": "release",
      "argv": [
        "npm",
        "run",
        "verify:release"
      ],
      "timeout": 1800,
      "tier": "heavy"
    },
    {
      "id": "browser-observatory",
      "argv": [
        "npm",
        "run",
        "qa:ci"
      ],
      "network": true,
      "timeout": 1800,
      "tier": "heavy"
    },
    {
      "id": "dependency-audit",
      "argv": [
        "npm",
        "audit",
        "--omit=dev",
        "--audit-level=critical"
      ],
      "network": true,
      "timeout": 120,
      "tier": "medium"
    }
  ],
  "heavy_limits": {
    "cpu_percent": 200,
    "memory_mb": 2048
  }
}
