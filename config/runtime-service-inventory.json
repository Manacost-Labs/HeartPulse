  "schedules": [
    {
      "id": "schedule-arena-subscription-refresh",
      "name": "subscription entitlement refresh",
      "trigger": "node-cron */30 * * * * in the Arena web process",
      "lifecycle": "Starts with the HTTP process and stops on SIGINT or SIGTERM before the bounded HTTP drain.",
      "idempotency": "Existing per-user refresh coalescing remains authoritative; there is no cross-instance distributed lock yet.",
      "owner": "subscription-platform",
      "criticality": "P1",
      "source": "frontend:server/modules/subscription/jobs/refreshJob.ts",
      "consumers": ["registered-users", "subscription-entitlements"],
      "healthImpact": "degraded",
      "readinessImpact": "none",
      "backup": "required",
      "runbook": "frontend:STABILIZATION.md"
    },
    {
      "id": "schedule-arena-scrape",
      "name": "arena snapshot scrape",
      "trigger": "OnBootSec=5m; OnCalendar=*-*-* 00/6:10:00 UTC; RandomizedDelaySec=10m; Persistent=true",
      "owner": "data-platform",
      "criticality": "P0",
      "source": "frontend:deploy/hs-arena-scraper.timer",
      "consumers": ["arena-scraper", "arena-server-data"],
      "healthImpact": "degraded",
      "readinessImpact": "degrades",
      "backup": "not-required",
      "runbook": "frontend:STABILIZATION.md"
    },
    {
      "id": "schedule-arena-backup",
      "name": "encrypted arena backup",
      "trigger": "OnCalendar=*-*-* 02:35:00 UTC; RandomizedDelaySec=20m; Persistent=true",
      "owner": "operations",
      "criticality": "P0",
      "source": "frontend:deploy/hs-arena-backup.timer",
      "consumers": ["arena-server-data", "arena-users-sqlite", "incident-recovery"],
      "healthImpact": "critical",
      "readinessImpact": "degrades",
      "backup": "required",
      "runbook": "frontend:DEPLOYMENT.md"
    },
    {
      "id": "schedule-arena-backup-verify",
      "name": "arena backup verification",
      "trigger": "OnCalendar=Sun *-*-* 04:20:00 UTC; RandomizedDelaySec=20m; Persistent=true",
      "owner": "operations",
      "criticality": "P0",
      "source": "frontend:deploy/hs-arena-backup-verify.timer",
      "consumers": ["incident-recovery", "operations"],
      "healthImpact": "critical",
      "readinessImpact": "degrades",
      "backup": "not-required",
      "runbook": "frontend:DEPLOYMENT.md"
    },
    {
      "id": "schedule-arena-backup-offsite",
      "name": "arena encrypted backup replication",
      "trigger": "OnCalendar=*-*-* 03:20:00 UTC; RandomizedDelaySec=20m; Persistent=true",
      "owner": "operations",
      "criticality": "P0",
      "source": "frontend:deploy/hs-arena-backup-replicate.timer",
      "consumers": ["incident-recovery", "offsite-backup-target"],
      "healthImpact": "critical",
      "readinessImpact": "degrades",
      "backup": "offsite-replica",
      "runbook": "frontend:DEPLOYMENT.md"
    },
    {
      "id": "schedule-data-api-full-refresh",
      "name": "data API full refresh",
      "trigger": "OnCalendar=*-*-* 07:00:00 Europe/Warsaw; Persistent=true",
      "owner": "data-platform",
      "criticality": "P0",
      "source": "data-api:systemd/hs-data-api-docker-refresh.timer",
      "consumers": ["all-parser-dataset-groups"],
      "healthImpact": "critical",
      "readinessImpact": "degrades",
      "backup": "not-required",
      "runbook": "data-api:PROXY_AND_RELIABILITY.md"
    },
    {
      "id": "schedule-data-api-tier-refresh",
      "name": "data API light and medium API-tier refresh",
      "trigger": "OnCalendar=*-*-* 18:00:00 Europe/Warsaw; Persistent=true",
      "owner": "data-platform",
      "criticality": "P0",
      "source": "data-api:systemd/hs-data-api-docker-refresh-api.timer",
      "consumers": ["api-tier-datasets"],
      "healthImpact": "critical",
      "readinessImpact": "degrades",
      "backup": "not-required",
      "runbook": "data-api:PROXY_AND_RELIABILITY.md"
