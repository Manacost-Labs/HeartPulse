{
  "schemaVersion": 1,
  "scope": "Versioned runtime ownership and criticality contract for hearthpulse.net and api.hs-manacost.ru",
  "idPolicy": "IDs are globally unique across every inventory collection.",
  "sourceNamespaces": {
    "frontend": "/var/www/koloda/data/www/hs-arena.ru/app",
    "data-api": "/srv/hs-data-api"
  },
  "notes": {
    "coverage": "The inventory records user-facing services, route families, all parser-control dataset groups, key production schedules, durable stores and shared caches. It intentionally does not copy every helper process or every in-process memoization map.",
    "runtimeState": "No live service status is stored here; health and timestamps must come from runtime probes.",
    "knownGaps": [
      "This classification is not yet consumed automatically by the website or data API readiness handlers.",
      "The data API has bounded local JSON history, but no repository-versioned encrypted off-host backup workflow for its complete data directory.",
      "The versioned nginx file is a path/include contract, not a complete copy of the production virtual host."
    ]
  },
  "services": [
    {
      "id": "service-origin-nginx",
      "name": "arena origin nginx",
      "owner": "web-platform",
      "criticality": "P0",
      "source": "frontend:deploy/nginx-paths.conf.example",
      "consumers": ["public-browser", "search-crawler", "arena-web-api"],
      "healthImpact": "critical",
      "readinessImpact": "blocks",
      "backup": "required",
      "runbook": "frontend:DEPLOYMENT.md"
